// =============================================================================
// TOPOLOGY TESTS (3 tests)
// =============================================================================

// TestIndexGraphConnectivity tests that graph remains connected
func TestIndexGraphConnectivity(t *testing.T) {
	idx := NewHSNWIndex(3, 16, 200, EuclideanDistance)

	// Add nodes
	for i := 0; i < 40; i++ {
		vec := []float32{float32(i), float32(i * 2), float32(i * 3)}
		err := idx.Add(fmt.Sprintf("node%d", i), vec)
		if err != nil {
			t.Fatalf("Failed to add node%d: %v", i, err)
		}
	}

	// Remove some nodes
	for i := 0; i < 15; i++ {
		err := idx.Remove(fmt.Sprintf("node%d", i*2))
		if err != nil {
			t.Fatalf("Failed to remove: %v", err)
		}
	}

	// Check connectivity via BFS from entry point
	idx.mu.RLock()
	defer idx.mu.RUnlock()

	if idx.entryPoint == nil {
		t.Fatal("Entry point should exist")
	}

	visited := make(map[string]bool)
	queue := []string{idx.entryPoint.ID}
	visited[idx.entryPoint.ID] = true

	// BFS at layer 0
	for len(queue) > 0 {
		currentID := queue[0]
		queue = queue[1:]

		node, exists := idx.nodes[currentID]
		if !exists {
			continue
		}

		if len(node.Neighbors) > 0 {
			for _, nid := range node.Neighbors[0] {
				if !visited[nid] {
					visited[nid] = true
					queue = append(queue, nid)
				}
			}
		}
	}

	// All nodes should be reachable
	unreachable := 0
	for id := range idx.nodes {
		if !visited[id] {
			unreachable++
			t.Logf("Node %s is unreachable from entry point", id)
		}
	}

	if unreachable > 0 {
		t.Errorf("Found %d unreachable nodes (graph is disconnected)", unreachable)
	}
}

// TestIndexEntryPointReachability tests that entry point is optimal
func TestIndexEntryPointReachability(t *testing.T) {
	idx := NewHSNWIndex(3, 16, 200, EuclideanDistance)

	// Add nodes
	for i := 0; i < 30; i++ {
		vec := []float32{float32(i), float32(i * 2), float32(i * 3)}
		err := idx.Add(fmt.Sprintf("node%d", i), vec)
		if err != nil {
			t.Fatalf("Failed to add node%d: %v", i, err)
		}
	}

	// Remove some nodes including potential entry points
	for i := 0; i < 10; i++ {
		err := idx.Remove(fmt.Sprintf("node%d", i))
		if err != nil {
			t.Fatalf("Failed to remove: %v", err)
		}
	}

	idx.mu.RLock()
	defer idx.mu.RUnlock()

	// Entry point should be highest level node
	if idx.entryPoint == nil {
		t.Fatal("Entry point should exist")
	}

	for _, node := range idx.nodes {
		if node.Level > idx.entryPoint.Level {
			t.Errorf("Found node %s with level %d higher than entry point level %d",
				node.ID, node.Level, idx.entryPoint.Level)
		}
	}

	// Entry point level should equal maxLevel
	if idx.entryPoint.Level != idx.maxLevel {
		t.Errorf("Entry point level %d should equal maxLevel %d",
			idx.entryPoint.Level, idx.maxLevel)
	}
}

// TestIndexLayerIntegrity tests layer structure integrity
func TestIndexLayerIntegrity(t *testing.T) {
	idx := NewHSNWIndex(3, 16, 200, EuclideanDistance)

	// Add nodes
	for i := 0; i < 50; i++ {
		vec := []float32{float32(i), float32(i * 2), float32(i * 3)}
		err := idx.Add(fmt.Sprintf("node%d", i), vec)
		if err != nil {
			t.Fatalf("Failed to add node%d: %v", i, err)
		}
	}

	// Remove nodes from various layers
	for i := 0; i < 20; i++ {
		err := idx.Remove(fmt.Sprintf("node%d", i*2))
		if err != nil {
			t.Fatalf("Failed to remove: %v", err)
		}
	}

	idx.mu.RLock()
	defer idx.mu.RUnlock()

	// Check layer structure
	layerCounts := make(map[int]int)
	for _, node := range idx.nodes {
		for level := 0; level <= node.Level; level++ {
			layerCounts[level]++
		}

		// Verify neighbor lists match level
		if len(node.Neighbors) != node.Level+1 {
			t.Errorf("Node %s has %d neighbor lists but level is %d",
				node.ID, len(node.Neighbors), node.Level)
		}

		// Verify neighbors at each level
		for level := 0; level <= node.Level; level++ {
			for _, nid := range node.Neighbors[level] {
				neighbor, exists := idx.nodes[nid]
				if !exists {
					t.Errorf("Node %s has non-existent neighbor %s at level %d",
						node.ID, nid, level)
					continue
				}

				// Neighbor must exist at this level
				if neighbor.Level < level {
					t.Errorf("Node %s (level %d) has neighbor %s (level %d) at level %d",
						node.ID, node.Level, nid, neighbor.Level, level)
				}
			}
		}
	}

	// Layer 0 should have all nodes
	if layerCounts[0] != len(idx.nodes) {
		t.Errorf("Layer 0 should have %d nodes, has %d", len(idx.nodes), layerCounts[0])
	}

	// Higher layers should have fewer nodes (exponential decay)
	for level := 1; level <= idx.maxLevel; level++ {
		if layerCounts[level] > layerCounts[level-1] {
			t.Errorf("Layer %d has more nodes (%d) than layer %d (%d)",
				level, layerCounts[level], level-1, layerCounts[level-1])
		}
	}
}
