// BenchmarkIndexRemove benchmarks basic remove operation
func BenchmarkIndexRemove(b *testing.B) {
	idx := NewHSNWIndex(128, 16, 200, EuclideanDistance)

	// Pre-populate with nodes
	nodeCount := 10000
	for i := 0; i < nodeCount; i++ {
		vec := make([]float32, 128)
		for j := 0; j < 128; j++ {
			vec[j] = rand.Float32()
		}
		idx.Add(fmt.Sprintf("node%d", i), vec)
	}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		targetID := fmt.Sprintf("node%d", i%nodeCount)
		idx.Remove(targetID)

		// Re-add if we're looping
		if i%nodeCount == 0 && i > 0 {
			for j := 0; j < nodeCount; j++ {
				vec := make([]float32, 128)
				for k := 0; k < 128; k++ {
					vec[k] = rand.Float32()
				}
				idx.Add(fmt.Sprintf("node%d", j), vec)
			}
		}
	}
}

