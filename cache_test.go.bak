// ==============================================================================
// UNIT TESTS - LRU Cache Mechanics (10 tests)
// ==============================================================================

// TestQueryCacheBasic tests basic cache operations
func TestQueryCacheBasic(t *testing.T) {
	cache := NewQueryCache(100)

	// Initially empty
	_, hit := cache.Get("key1")
	if hit {
		t.Error("expected cache miss on empty cache")
	}

	// Add entry
	results := []Treasure{
		{ID: "vec1", Distance: 0.1},
		{ID: "vec2", Distance: 0.2},
	}
	cache.Put("key1", results)

	// Should hit now
	cached, hit := cache.Get("key1")
	if !hit {
		t.Error("expected cache hit")
	}

	if len(cached) != len(results) {
		t.Errorf("expected %d results, got %d", len(results), len(cached))
	}
}

// TestQueryCacheLRUEviction tests that LRU eviction works
func TestQueryCacheLRUEviction(t *testing.T) {
	cache := NewQueryCache(3) // Small cache

	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	// Fill cache
	cache.Put("key1", results)
	cache.Put("key2", results)
	cache.Put("key3", results)

	// All should be present
	if _, hit := cache.Get("key1"); !hit {
		t.Error("key1 should be in cache")
	}

	// Add one more - should evict oldest (key1)
	cache.Put("key4", results)

	// key1 should be evicted
	if _, hit := cache.Get("key1"); hit {
		t.Error("key1 should have been evicted")
	}

	// Others should still be there
	if _, hit := cache.Get("key2"); !hit {
		t.Error("key2 should still be in cache")
	}
}

// TestQueryCacheLRUOrdering tests that access updates LRU order
func TestQueryCacheLRUOrdering(t *testing.T) {
	cache := NewQueryCache(3)

	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	// Fill cache
	cache.Put("key1", results)
	cache.Put("key2", results)
	cache.Put("key3", results)

	// Access key1 to make it most recently used
	cache.Get("key1")

	// Add key4 - should evict key2 (oldest non-accessed)
	cache.Put("key4", results)

	// key1 should still be there
	if _, hit := cache.Get("key1"); !hit {
		t.Error("key1 should still be in cache")
	}

	// key2 should be evicted
	if _, hit := cache.Get("key2"); hit {
		t.Error("key2 should have been evicted")
	}
}

// TestCacheKeyGeneration tests cache key generation consistency
func TestCacheKeyGeneration(t *testing.T) {
	query1 := []float32{1.0, 2.0, 3.0}
	query2 := []float32{1.0, 2.0, 3.0}
	query3 := []float32{1.0, 2.0, 3.1}

	key1 := generateCacheKey(query1, 10, nil)
	key2 := generateCacheKey(query2, 10, nil)
	key3 := generateCacheKey(query3, 10, nil)

	// Same query should generate same key
	if key1 != key2 {
		t.Error("identical queries should generate same cache key")
	}

	// Different query should generate different key
	if key1 == key3 {
		t.Error("different queries should generate different keys")
	}
}

// TestCacheKeyWithDifferentK tests that k parameter affects cache key
func TestCacheKeyWithDifferentK(t *testing.T) {
	query := []float32{1.0, 2.0, 3.0}

	key1 := generateCacheKey(query, 10, nil)
	key2 := generateCacheKey(query, 20, nil)

	if key1 == key2 {
		t.Error("different k values should generate different keys")
	}
}

// TestCacheInvalidation tests full cache invalidation
func TestCacheInvalidation(t *testing.T) {
	cache := NewQueryCache(100)

	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	// Add entries
	cache.Put("key1", results)
	cache.Put("key2", results)

	// Verify they're there
	if _, hit := cache.Get("key1"); !hit {
		t.Error("expected cache hit before invalidation")
	}

	// Invalidate
	cache.Invalidate()

	// Should all be gone
	if _, hit := cache.Get("key1"); hit {
		t.Error("cache should be empty after invalidation")
	}
	if _, hit := cache.Get("key2"); hit {
		t.Error("cache should be empty after invalidation")
	}
}

// TestCacheStats tests hit/miss statistics
func TestCacheStats(t *testing.T) {
	cache := NewQueryCache(100)

	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	// Initial stats should be zero
	hits, misses, hitRate := cache.Stats()
	if hits != 0 || misses != 0 {
		t.Errorf("expected zero stats, got hits=%d, misses=%d", hits, misses)
	}

	// Miss
	cache.Get("key1")

	// Add and hit
	cache.Put("key1", results)
	cache.Get("key1")
	cache.Get("key1")

	// Check stats: 2 hits, 1 miss
	hits, misses, hitRate = cache.Stats()
	if hits != 2 {
		t.Errorf("expected 2 hits, got %d", hits)
	}
	if misses != 1 {
		t.Errorf("expected 1 miss, got %d", misses)
	}
	if hitRate < 0.66 || hitRate > 0.67 {
		t.Errorf("expected hit rate ~0.67, got %.2f", hitRate)
	}
}

// TestCacheConcurrentAccess tests concurrent cache access
func TestCacheConcurrentAccess(t *testing.T) {
	cache := NewQueryCache(1000)

	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	var wg sync.WaitGroup
	numGoroutines := 50
	numOps := 100

	for i := 0; i < numGoroutines; i++ {
		wg.Add(1)
		go func(id int) {
			defer wg.Done()
			for j := 0; j < numOps; j++ {
				key := fmt.Sprintf("key%d", j%10)
				if j%2 == 0 {
					cache.Put(key, results)
				} else {
					cache.Get(key)
				}
			}
		}(i)
	}

	wg.Wait()

	// Should not panic or deadlock
	t.Log("Concurrent access test completed without issues")
}

// TestCacheEmptyResults tests caching empty result sets
func TestCacheEmptyResults(t *testing.T) {
	cache := NewQueryCache(100)

	emptyResults := []Treasure{}
	cache.Put("key1", emptyResults)

	cached, hit := cache.Get("key1")
	if !hit {
		t.Error("expected cache hit for empty results")
	}

	if len(cached) != 0 {
		t.Errorf("expected empty results, got %d items", len(cached))
	}
}

// TestCacheLargeResultSet tests caching large result sets
func TestCacheLargeResultSet(t *testing.T) {
	cache := NewQueryCache(10)

	// Create large result set
	results := make([]Treasure, 1000)
	for i := range results {
		results[i] = Treasure{
			ID:       fmt.Sprintf("vec%d", i),
			Distance: float32(i) * 0.01,
		}
	}

	cache.Put("key1", results)

	cached, hit := cache.Get("key1")
	if !hit {
		t.Error("expected cache hit")
	}

	if len(cached) != len(results) {
		t.Errorf("expected %d results, got %d", len(results), len(cached))
	}
}

// ==============================================================================
// INTEGRATION TESTS - Cache with Database (8 tests)
// ==============================================================================

// TestCacheWithFind tests that cache integrates with Find
func TestCacheWithFind(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	// Enable caching
	nest.enableQueryCache(100)

	// Populate database
	for i := 0; i < 100; i++ {
		id := fmt.Sprintf("vec%d", i)
		vector := make([]float32, 128)
		for j := range vector {
			vector[j] = rand.Float32()
		}
		nest.Store(id, vector)
	}

	query := make([]float32, 128)
	for i := range query {
		query[i] = rand.Float32()
	}

	// First call - should miss cache
	start := time.Now()
	results1 := nest.Find(query, 10)
	firstTime := time.Since(start)

	// Second call - should hit cache
	start = time.Now()
	results2 := nest.Find(query, 10)
	secondTime := time.Since(start)

	// Results should be identical
	if len(results1) != len(results2) {
		t.Errorf("results differ: %d vs %d", len(results1), len(results2))
	}

	// Second should be much faster
	speedup := float64(firstTime) / float64(secondTime)
	t.Logf("First: %v, Second: %v, Speedup: %.2fx", firstTime, secondTime, speedup)

	if speedup < 2.0 {
		t.Logf("Note: Limited cache speedup (%.2fx)", speedup)
	}
}

// TestCacheInvalidationOnStore tests that cache is invalidated on Store
func TestCacheInvalidationOnStore(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(100)

	// Populate
	for i := 0; i < 50; i++ {
		id := fmt.Sprintf("vec%d", i)
		nest.Store(id, make([]float32, 128))
	}

	query := make([]float32, 128)

	// Prime cache
	results1 := nest.Find(query, 10)

	// Store new vector - should invalidate cache
	nest.Store("vec_new", make([]float32, 128))

	// Query again - cache should be invalidated
	results2 := nest.Find(query, 10)

	// Results might differ due to new vector
	// But cache should have been invalidated and recalculated
	t.Logf("Results before: %d, after: %d", len(results1), len(results2))
}

// TestCacheInvalidationOnRemove tests that cache is invalidated on Remove
func TestCacheInvalidationOnRemove(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(100)

	// Populate
	for i := 0; i < 50; i++ {
		id := fmt.Sprintf("vec%d", i)
		nest.Store(id, make([]float32, 128))
	}

	query := make([]float32, 128)

	// Prime cache
	nest.Find(query, 10)

	// Get initial stats
	if nest.queryCache != nil {
		hits1, _, _ := nest.queryCache.Stats()

		// Query again (should hit cache)
		nest.Find(query, 10)

		hits2, _, _ := nest.queryCache.Stats()
		if hits2 <= hits1 {
			t.Error("expected cache hit")
		}

		// Remove a vector
		nest.Remove("vec0")

		// Cache should be invalidated
		// Next query should miss
		hits3, _, _ := nest.queryCache.Stats()
		nest.Find(query, 10)
		hits4, _, _ := nest.queryCache.Stats()

		// Hits should not increase (cache miss after invalidation)
		if hits4 > hits3 {
			t.Log("Note: Cache may not have been fully invalidated")
		}
	}
}

// TestCacheWithConcurrentReads tests cache under concurrent reads
func TestCacheWithConcurrentReads(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(100)

	// Populate
	for i := 0; i < 100; i++ {
		id := fmt.Sprintf("vec%d", i)
		vector := make([]float32, 128)
		for j := range vector {
			vector[j] = rand.Float32()
		}
		nest.Store(id, vector)
	}

	query := make([]float32, 128)

	// Concurrent reads
	var wg sync.WaitGroup
	numReaders := 20
	numQueries := 50

	var totalHits atomic.Int64

	for i := 0; i < numReaders; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for j := 0; j < numQueries; j++ {
				results := nest.Find(query, 10)
				if len(results) > 0 {
					totalHits.Add(1)
				}
			}
		}()
	}

	wg.Wait()

	if nest.queryCache != nil {
		hits, misses, hitRate := nest.queryCache.Stats()
		t.Logf("Hits: %d, Misses: %d, Hit Rate: %.2f%%", hits, misses, hitRate*100)

		if hitRate < 0.5 {
			t.Errorf("expected high hit rate under concurrent reads, got %.2f", hitRate)
		}
	}
}

// TestCacheHitRate tests overall cache hit rate
func TestCacheHitRate(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(100)

	// Populate
	for i := 0; i < 100; i++ {
		id := fmt.Sprintf("vec%d", i)
		vector := make([]float32, 128)
		nest.Store(id, vector)
	}

	// Create a few queries
	queries := make([][]float32, 10)
	for i := range queries {
		queries[i] = make([]float32, 128)
		for j := range queries[i] {
			queries[i][j] = rand.Float32()
		}
	}

	// Execute queries multiple times
	for i := 0; i < 100; i++ {
		queryIdx := i % len(queries)
		nest.Find(queries[queryIdx], 10)
	}

	if nest.queryCache != nil {
		hits, misses, hitRate := nest.queryCache.Stats()
		t.Logf("Hits: %d, Misses: %d, Hit Rate: %.2f%%", hits, misses, hitRate*100)

		// With 10 queries repeated 100 times, hit rate should be ~90%
		if hitRate < 0.8 {
			t.Errorf("expected high hit rate with repeated queries, got %.2f", hitRate)
		}
	}
}

// TestCacheMemoryFootprint tests cache memory usage
func TestCacheMemoryFootprint(t *testing.T) {
	cache := NewQueryCache(1000)

	results := make([]Treasure, 100)
	for i := range results {
		results[i] = Treasure{
			ID:       fmt.Sprintf("vec%d", i),
			Vector:   make([]float32, 128),
			Distance: float32(i),
		}
	}

	// Fill cache
	for i := 0; i < 1000; i++ {
		key := fmt.Sprintf("query%d", i)
		cache.Put(key, results)
	}

	// Check that cache doesn't grow beyond max size
	// This is implicitly tested by LRU eviction
	t.Log("Cache filled with 1000 entries successfully")
}

// TestCacheWithFilters tests that filters affect cache keys
func TestCacheWithFilters(t *testing.T) {
	nest := createTestNest(t)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(100)

	// Populate with metadata
	for i := 0; i < 50; i++ {
		id := fmt.Sprintf("vec%d", i)
		vector := make([]float32, 128)
		metadata := map[string]interface{}{
			"category": i % 2,
		}
		nest.Store(id, vector, metadata)
	}

	query := make([]float32, 128)

	// Different filters should generate different cache keys
	// This test verifies conceptually that filters would affect caching
	results1 := nest.Find(query, 10)
	results2 := nest.Find(query, 20) // Different k

	// Results should differ
	if len(results1) == len(results2) && len(results1) > 10 {
		t.Log("Note: Different k values returned same number of results")
	}
}

// TestCachePersistenceAcrossRestarts tests that cache doesn't persist
func TestCachePersistenceAcrossRestarts(t *testing.T) {
	path := createTempPath(t)
	defer cleanupPath(path)

	// First session
	nest1, _ := Open(path)
	nest1.enableQueryCache(100)

	for i := 0; i < 50; i++ {
		id := fmt.Sprintf("vec%d", i)
		nest1.Store(id, make([]float32, 128))
	}

	query := make([]float32, 128)
	nest1.Find(query, 10)

	nest1.Close()

	// Second session
	nest2, _ := Open(path)
	defer nest2.Close()

	nest2.enableQueryCache(100)

	// Cache should be empty (not persisted)
	if nest2.queryCache != nil {
		hits, misses, _ := nest2.queryCache.Stats()
		if hits != 0 || misses != 0 {
			t.Error("cache stats should be zero after restart")
		}
	}
}

