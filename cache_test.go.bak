	results := []Treasure{{ID: "vec1", Distance: 0.1}}

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		key := fmt.Sprintf("key%d", i%1000)
		cache.Put(key, results)
