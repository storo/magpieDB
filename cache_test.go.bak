// BenchmarkCacheHit benchmarks cache hit performance
func BenchmarkCacheHit(b *testing.B) {
	cache := NewQueryCache(1000)

	results := []Treasure{{ID: "vec1", Distance: 0.1}}
	cache.Put("key1", results)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		cache.Get("key1")
	}
}

// BenchmarkCacheMiss benchmarks cache miss performance
func BenchmarkCacheMiss(b *testing.B) {
	cache := NewQueryCache(1000)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		cache.Get(fmt.Sprintf("key%d", i))
	}
}

// BenchmarkCachePut benchmarks cache put performance
func BenchmarkCachePut(b *testing.B) {
