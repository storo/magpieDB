}

// BenchmarkFindWithCache benchmarks Find with caching enabled
func BenchmarkFindWithCache(b *testing.B) {
	nest := createTestNestB(b)
	defer cleanupTestNest(nest)

	nest.enableQueryCache(1000)

	// Populate
	for i := 0; i < 1000; i++ {
		id := fmt.Sprintf("vec%d", i)
		vector := make([]float32, 128)
		nest.Store(id, vector)
	}

	query := make([]float32, 128)

	b.ResetTimer()
	b.ReportAllocs()

	for i := 0; i < b.N; i++ {
		nest.Find(query, 10)
	}

	if nest.queryCache != nil {
		hits, misses, hitRate := nest.queryCache.Stats()
		b.Logf("Hits: %d, Misses: %d, Hit Rate: %.2f%%", hits, misses, hitRate*100)
	}
}

// ==============================================================================
// HELPER FUNCTIONS
// ==============================================================================

// enableQueryCache is a helper to enable caching on a Nest
func (n *Nest) enableQueryCache(size int) {
	n.queryCache = NewQueryCache(size)
}

// generateCacheKey generates a cache key for a query
// This is a placeholder - actual implementation in cache.go
func generateCacheKey(query []float32, k int, filter Filter) string {
	h := fnv.New64a()

	// Hash query vector
	for _, v := range query {
		b := make([]byte, 4)
		b[0] = byte(v)
		b[1] = byte(v >> 8)
		b[2] = byte(v >> 16)
		b[3] = byte(v >> 24)
		h.Write(b)
	}

	// Hash k
	h.Write([]byte(fmt.Sprintf("k=%d", k)))

	// Hash filter (if present)
	if filter != nil {
		h.Write([]byte(fmt.Sprintf("filter=%v", filter)))
	}

	return fmt.Sprintf("%x", h.Sum64())
}
