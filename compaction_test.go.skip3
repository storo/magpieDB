	// Verify temp file was cleaned up
	tempPath := nest.path + ".tmp"
	if _, err := os.Stat(tempPath); err == nil {
		t.Error("Temporary file should be cleaned up after compaction")
	}
}

// TestCompactVectorPreservation tests that all vectors are preserved
func TestCompactVectorPreservation(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors with known data
	testVectors := make(map[string][]float32)
	for i := 0; i < 20; i++ {
		vec := makeTestVector(128, i)
		id := fmt.Sprintf("vec_%d", i)
		testVectors[id] = vec
		nest.Store(id, vec)
	}

	countBefore := nest.Count()

	// Compact
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	countAfter := nest.Count()

	if countBefore != countAfter {
		t.Errorf("Vector count changed: before=%d, after=%d", countBefore, countAfter)
	}

	// Verify all vectors still exist and have correct data
	for id, expectedVec := range testVectors {
		treasure, err := nest.Get(id)
		if err != nil {
			t.Errorf("Failed to retrieve vector %s after compaction: %v", id, err)
			continue
		}

		if !vectorsEqual(treasure.Vector, expectedVec) {
			t.Errorf("Vector %s data changed after compaction", id)
		}
	}
}

// TestCompactMetadataPreservation tests metadata preservation
func TestCompactMetadataPreservation(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors with metadata
	for i := 0; i < 10; i++ {
		vec := makeTestVector(128, i)
		id := fmt.Sprintf("vec_%d", i)
		metadata := map[string]interface{}{
			"index":    i,
			"category": fmt.Sprintf("cat_%d", i%3),
		}
		nest.Store(id, vec, metadata)
	}

	// Compact
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	// Verify metadata
	for i := 0; i < 10; i++ {
		id := fmt.Sprintf("vec_%d", i)
		treasure, err := nest.Get(id)
		if err != nil {
			t.Errorf("Failed to get vector: %v", err)
			continue
		}

		if treasure.Metadata == nil {
			t.Errorf("Vector %s lost metadata after compaction", id)
			continue
		}

		if treasure.Metadata["index"] != float64(i) { // JSON numbers are float64
			t.Errorf("Vector %s metadata corrupted", id)
		}
	}
}

// TestCompactIndexRebuild tests HNSW index rebuilding
func TestCompactIndexRebuild(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 30; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	// Perform a search before compaction
	queryVec := makeTestVector(128, 0)
	resultsBefore := nest.Find(queryVec, 5)

	// Compact
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	// Perform same search after compaction
	resultsAfter := nest.Find(queryVec, 5)

	if len(resultsBefore) != len(resultsAfter) {
		t.Errorf("Search results changed after compaction: before=%d, after=%d",
			len(resultsBefore), len(resultsAfter))
	}

	// Results should be similar (HNSW rebuild may produce slightly different graph topology)
	// Instead of exact ID match, verify distance quality is maintained
	if len(resultsBefore) > 0 && len(resultsAfter) > 0 {
		distBefore := resultsBefore[0].Distance
		distAfter := resultsAfter[0].Distance

		// Allow 10% tolerance for distance differences due to graph rebuild
		distDiff := (distAfter - distBefore) / distBefore
		if distDiff > 0.10 {
			t.Errorf("Search quality degraded significantly after compaction: before=%.4f, after=%.4f (%.2f%% increase)",
				distBefore, distAfter, distDiff*100)
		}

		// Log the results for debugging
		t.Logf("Top result before: ID=%s, distance=%.4f", resultsBefore[0].ID, distBefore)
		t.Logf("Top result after: ID=%s, distance=%.4f", resultsAfter[0].ID, distAfter)
	}
}

