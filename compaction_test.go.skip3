	frag := nest.calculateFragmentation()

	// Initially, fragmentation should be low
	if frag < 0 || frag > 1.0 {
		t.Errorf("Fragmentation should be between 0 and 1, got %.2f", frag)
	}
}

// TestShouldCompact tests compaction decision logic
func TestShouldCompact(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Initially, should not need compaction
	if nest.shouldCompact() {
		t.Error("New database should not need compaction")
	}

	// After many inserts, might need compaction (depends on implementation)
	for i := 0; i < 100; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}
}

// TestCompactTempFileCreation tests temporary file creation
func TestCompactTempFileCreation(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

