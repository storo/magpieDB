// Integration Tests (12 tests)

// TestCompactWithConcurrentReads tests compaction with concurrent reads
func TestCompactWithConcurrentReads(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 50; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	var wg sync.WaitGroup
	errors := make(chan error, 20)

	// Start concurrent readers
	for i := 0; i < 10; i++ {
		wg.Add(1)
		go func(readerID int) {
			defer wg.Done()
			for j := 0; j < 10; j++ {
				id := fmt.Sprintf("vec_%d", j%50)
				_, err := nest.Get(id)
				if err != nil {
					errors <- fmt.Errorf("Reader %d failed: %w", readerID, err)
					return
				}
				time.Sleep(time.Millisecond)
			}
		}(i)
	}

	// Start compaction
	time.Sleep(10 * time.Millisecond)
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	wg.Wait()
	close(errors)

	// Check for errors
	for err := range errors {
		t.Errorf("Concurrent read error: %v", err)
	}
}

// TestCompactMultipleTimes tests running compaction multiple times
func TestCompactMultipleTimes(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 20; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	// Compact multiple times
	for i := 0; i < 3; i++ {
		err := nest.Compact()
		if err != nil {
			t.Fatalf("Compaction %d failed: %v", i+1, err)
		}

		// Verify data integrity
		if nest.Count() != 20 {
			t.Errorf("Vector count wrong after compaction %d: %d", i+1, nest.Count())
		}
	}
}

// TestCompactWithSearches tests searches work during compaction
func TestCompactWithSearches(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 40; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	var wg sync.WaitGroup
	queryVec := makeTestVector(128, 0)

	// Start concurrent searchers
	for i := 0; i < 5; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for j := 0; j < 10; j++ {
				results := nest.Find(queryVec, 5)
				if len(results) == 0 {
					t.Error("Search returned no results during compaction")
				}
				time.Sleep(time.Millisecond * 5)
			}
		}()
	}

	// Compact
	time.Sleep(10 * time.Millisecond)
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	wg.Wait()
}

