// TestCompactLargeDatabase tests compaction on larger database
func TestCompactLargeDatabase(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert many vectors
	for i := 0; i < 200; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	start := time.Now()
	err := nest.Compact()
	duration := time.Since(start)

	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	t.Logf("Compacted 200 vectors in %v", duration)

	if nest.Count() != 200 {
		t.Errorf("Vector count wrong after compaction: %d", nest.Count())
	}
}

// TestCompactStats tests compaction statistics tracking
func TestCompactStats(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 30; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	// Compact and check metrics
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

