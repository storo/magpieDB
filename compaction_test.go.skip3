// Unit Tests (15 tests)

// TestCollectLiveVectors tests live vector collection
func TestCollectLiveVectors(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert 10 vectors
	for i := 0; i < 10; i++ {
		vec := makeTestVector(128, i)
		err := nest.Store(fmt.Sprintf("vec_%d", i), vec)
		if err != nil {
			t.Fatalf("Failed to store vector: %v", err)
		}
	}

	// Collect live vectors
	liveVectors := nest.collectLiveVectors()

	if len(liveVectors) != 10 {
		t.Errorf("Expected 10 live vectors, got %d", len(liveVectors))
	}

	// Verify vector data
	for _, vec := range liveVectors {
		if len(vec.Vector) != 128 {
			t.Errorf("Expected vector dimension 128, got %d", len(vec.Vector))
		}
	}
}

// TestEstimateSize tests size estimation
func TestEstimateSize(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert some vectors
	for i := 0; i < 5; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	estimated := nest.estimateSize()
	if estimated == 0 {
		t.Error("Expected non-zero estimated size")
	}

	// Estimated size should be reasonable
	if estimated > 1000000 { // 1MB is too much for 5 vectors
		t.Errorf("Estimated size too large: %d bytes", estimated)
	}
}

// TestCalculateFragmentation tests fragmentation calculation
func TestCalculateFragmentation(t *testing.T) {
	nest := setupTestCompactionDB(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors
	for i := 0; i < 10; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
