// TestCompactAfterDatabaseReopen tests compaction after reopening database
func TestCompactAfterDatabaseReopen(t *testing.T) {
	path := fmt.Sprintf("/tmp/test_compact_reopen_%d.magpie", time.Now().UnixNano())
	cleanupPath(path)

	// Create and populate database
	nest1, err := Open(path, Options{Dimensions: 128, WAL: false})
	if err != nil {
		t.Fatalf("Failed to open database: %v", err)
	}

	for i := 0; i < 15; i++ {
		vec := makeTestVector(128, i)
		nest1.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	nest1.Close()

	// Reopen and compact
	nest2, err := Open(path, Options{Dimensions: 128, WAL: false})
	if err != nil {
		t.Fatalf("Failed to reopen database: %v", err)
	}
	defer cleanupPath(path)
	defer nest2.Close()

	err = nest2.Compact()
	if err != nil {
		t.Fatalf("Compaction after reopen failed: %v", err)
	}

	if nest2.Count() != 15 {
		t.Errorf("Vector count wrong after compaction: %d", nest2.Count())
	}
}

