// TestCompactWALTruncation tests WAL truncation after compaction
func TestCompactWALTruncation(t *testing.T) {
	nest := setupTestCompactionDBWithWAL(t)
	defer cleanupTestDB(t, nest)

	// Insert vectors to generate WAL entries
	for i := 0; i < 20; i++ {
		vec := makeTestVector(128, i)
		nest.Store(fmt.Sprintf("vec_%d", i), vec)
	}

	// Force WAL flush (WAL uses buffering and auto-flushes at 100 entries)
	// We only inserted 20 vectors, so we need to flush manually
	if nest.wal != nil {
		if err := nest.wal.Flush(); err != nil {
			t.Fatalf("Failed to flush WAL: %v", err)
		}
	}

	// WAL should have entries
	if nest.wal != nil {
		walSize := nest.wal.Size()
		if walSize == 0 {
			t.Error("Expected WAL to have entries before compaction")
		}
		t.Logf("WAL size before compaction: %d bytes", walSize)
	}

	// Compact
	err := nest.Compact()
	if err != nil {
		t.Fatalf("Compaction failed: %v", err)
	}

	// WAL should be smaller or empty after compaction
	if nest.wal != nil {
		walSize := nest.wal.Size()
		// After compaction, WAL should be truncated
		// (exact behavior depends on implementation)
		t.Logf("WAL size after compaction: %d bytes", walSize)
	}
}

