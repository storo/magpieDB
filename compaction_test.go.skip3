// Helper functions

func setupTestCompactionDB(t *testing.T) *Nest {
	path := fmt.Sprintf("/tmp/test_compaction_%s.magpie", t.Name())
	cleanupPath(path)

	nest, err := Open(path, Options{
		Dimensions: 128,
		Distance:   "cosine",
		WAL:        false,
	})
	if err != nil {
		t.Fatalf("Failed to open database: %v", err)
	}
	return nest
}

func setupTestCompactionDBWithWAL(t *testing.T) *Nest {
	path := fmt.Sprintf("/tmp/test_compaction_wal_%s.magpie", t.Name())
	cleanupPath(path)

	nest, err := Open(path, Options{
		Dimensions: 128,
		Distance:   "cosine",
		WAL:        true,
	})
	if err != nil {
		t.Fatalf("Failed to open database: %v", err)
	}
	return nest
}

func makeTestVector(dim int, seed int) []float32 {
	vec := make([]float32, dim)
	for i := range vec {
		vec[i] = float32((seed*1000+i)%100) / 100.0
	}
	return vec
}

func vectorsEqual(a, b []float32) bool {
	if len(a) != len(b) {
		return false
	}
	for i := range a {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
